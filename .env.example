# Expo 2026 — Environment Variables Configuration
# Copy this file to .env for local development
# Add these exact variables to your Vercel Project Settings (Settings -> Environment Variables)

# -------------------------------------------------------------
# Admin Credentials
# -------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=exhibition2026

# -------------------------------------------------------------
# Security & Session
# -------------------------------------------------------------
# A random secret string used to sign session tokens securely
SESSION_SECRET=expo2026-secure-session-secret-change-me

# -------------------------------------------------------------
# Database / Backend
# -------------------------------------------------------------
# Firebase Realtime Database URL (default RTDB or your own Firebase project)
FIREBASE_DATABASE_URL=https://du-spoofer-default-rtdb.firebaseio.com

# Optional Firebase Database Secret / Auth Token (if rules require admin auth)
FIREBASE_AUTH_SECRET=

# -------------------------------------------------------------
# Exhibition Meta (Optional)
# -------------------------------------------------------------
SITE_NAME=Expo 2026 School Exhibition
EXHIBITION_YEAR=2026
ALLOW_PUBLIC_SUBMISSIONS=true
